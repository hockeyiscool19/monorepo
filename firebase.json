{
  "hosting": {
    "site": "eisensoftware",
    "public": "apps/portal/build",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/registry.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=60"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/healthconnect{,/**}",
        "run": {
          "serviceId": "jordan-lifts",
          "region": "us-central1"
        }
      },
      {
        "source": "/topology{,/**}",
        "run": {
          "serviceId": "topology",
          "region": "us-central1"
        }
      },
      {
        "source": "/vale{,/**}",
        "run": {
          "serviceId": "vale",
          "region": "us-central1"
        }
      }
    ]
  }
}
